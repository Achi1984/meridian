FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293

WORKDIR /app

COPY --chown=node:node scripts/spot-paper-paired/ ./scripts/spot-paper-paired/
COPY --chown=node:node scripts/spot-paper-pilot/core.mjs ./scripts/spot-paper-pilot/core.mjs
COPY --chown=node:node scripts/spot-paper-pilot/journal.mjs ./scripts/spot-paper-pilot/journal.mjs
COPY --chown=node:node scripts/spot-paper-pilot/provider.mjs ./scripts/spot-paper-pilot/provider.mjs
COPY --chown=node:node scripts/spot-paper-pilot/package-host-evidence.mjs ./scripts/spot-paper-pilot/package-host-evidence.mjs
COPY --chown=node:node scripts/spot-paper-paired-report/ ./scripts/spot-paper-paired-report/
COPY --chown=node:node scripts/spot-paper-research/comparison.mjs ./scripts/spot-paper-research/comparison.mjs
COPY --chown=node:node scripts/spot-paper-research/entry-confirmation.mjs ./scripts/spot-paper-research/entry-confirmation.mjs
COPY --chown=node:node scripts/spot-paper-research/five-minute-trend.mjs ./scripts/spot-paper-research/five-minute-trend.mjs

RUN mkdir -p /evidence-root /tmp/spot-paper-paired-package && \
    chown node:node /evidence-root /tmp/spot-paper-paired-package

ENV NODE_ENV=production
USER node

ENTRYPOINT ["node", "scripts/spot-paper-paired/host.mjs"]
CMD ["disabled"]
