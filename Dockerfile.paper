FROM node:20-alpine

WORKDIR /app

COPY --chown=node:node scripts/memecoin-paper/ ./scripts/memecoin-paper/
COPY --chown=node:node scripts/memecoin-paper-token-safety/ ./scripts/memecoin-paper-token-safety/
COPY --chown=node:node scripts/memecoin-paper-simulated-evaluation/index.mjs ./scripts/memecoin-paper-simulated-evaluation/index.mjs
COPY --chown=node:node scripts/memecoin-paper-run-export-transfer/index.mjs ./scripts/memecoin-paper-run-export-transfer/index.mjs
COPY --chown=node:node scripts/memecoin-paper-run-export-https/https.mjs ./scripts/memecoin-paper-run-export-https/https.mjs
COPY --chown=node:node scripts/memecoin-paper-export-host.mjs ./scripts/memecoin-paper-export-host.mjs
RUN mkdir -p /var/data/meridian-paper && chown node:node /var/data/meridian-paper

ENV NODE_ENV=production
USER node

ENTRYPOINT ["node", "scripts/memecoin-paper/pilot-online.mjs"]
